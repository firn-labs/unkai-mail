{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capabilities for the Unkai main window and any popped-out standalone windows (mail #104, compose #110, reminder #203, event-editor #304, signature-editor #314).",
  "windows": ["main", "mail-*", "compose-*", "reminder-*", "event-editor-*", "signature-editor-*"],
  "permissions": [
    "core:default",
    "core:webview:allow-create-webview-window",
    "core:window:allow-close",
    "notification:default",
    "dialog:default",
    "autostart:allow-enable",
    "autostart:allow-disable",
    "autostart:allow-is-enabled",
    "deep-link:default"
  ]
}
