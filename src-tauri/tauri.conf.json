{
  "$schema": "https://raw.githubusercontent.com/nicehash/tauri/dev/packages/tauri-config-schema/schema.json",
  "productName": "Unkai-Mail",
  "version": "0.4.1",
  "identifier": "com.unkai.mail",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "cd ../ui && npm run dev",
    "beforeBuildCommand": "cd ../ui && npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Unkai Mail",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "visible": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "publisher": "Firn Labs",
    "copyright": "© 2026 Firn Labs",
    "homepage": "https://github.com/firn-labs/unkai-mail",
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp",
        "installerHooks": "installer/hooks.nsh"
      },
      "wix": {
        "bannerPath": "installer/wix-banner.bmp",
        "dialogImagePath": "installer/wix-dialog.bmp"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["ics"],
        "name": "iCalendar Event",
        "description": "iCalendar event invitation",
        "mimeType": "text/calendar",
        "role": "Editor"
      },
      {
        "ext": ["eml"],
        "name": "Email Message",
        "description": "RFC 822 email message",
        "mimeType": "message/rfc822",
        "role": "Viewer"
      }
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEMzRjk1MkUwNThCQTA0QkYKUldTL0JMcFk0Rkw1dzdTUC9RM01aMEtJRmhnSzBYZzl4akxLdFdleGJIbEFPMlVSRFJLTXlMWWUK",
      "endpoints": [
        "https://github.com/firn-labs/unkai-mail/releases/latest/download/latest.json"
      ]
    },
    "deep-link": {
      "mobile": [],
      "desktop": {
        "schemes": ["mailto"]
      }
    }
  }
}
